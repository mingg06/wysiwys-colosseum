
# Reference template only. Never commit the real .env or share credential values.
# Set a user-controlled Scorechain key locally. Do not paste it into chat.
CRE_SCORECHAIN_SANCTIONS_API_KEY=
CRE_QUICKNODE_SOLANA_DEVNET_RPC_URL=
CRE_HELIUS_SOLANA_DEVNET_RPC_URL=
CRE_ALCHEMY_SOLANA_DEVNET_RPC_URL=

# Exact fresh treasury policy document matching its immutable GuardConfig commitment.
# One line of JSON. Never commit the policy or whitelist.
CRE_POLICY_DOCUMENT=

# Token matching the runner POLICY_FETCH_TOKEN when fetching policies by hash.
CRE_POLICY_STORE_TOKEN=

# Devnet simulation/report transmitter and the CLI-required throwaway EVM key.
# Fill privately using the format required by the pinned CRE CLI.
CRE_SOLANA_PRIVATE_KEY=
CRE_ETH_PRIVATE_KEY=
