# Railway service variables. Devnet only. Replace placeholders in Railway, never commit real values.
RUNNER_DB_PATH=/data/runner.db
BACKFILL_INTERVAL_MS=60000
SETTLEMENT_TOKEN=REPLACE_WITH_RANDOM_TOKEN
HELIUS_DEVNET_RPC_URL=REPLACE_WITH_DEVNET_HTTPS_RPC
HELIUS_DEVNET_WS_URL=REPLACE_WITH_DEVNET_WSS_RPC
# Simulation's local policy-store URL uses 8787. Set the public domain's target port to match.
PORT=8787

# Default Docker image supports CRE simulation. Remove these values and set CRE_PROJECT_DIR empty
# if using an already deployed live workflow instead.
CRE_API_KEY=REPLACE_WITH_CHAINLINK_API_KEY
CRE_PROJECT_DIR=/opt/wysiwys/workflow/confidential-preflight
CRE_WORKFLOW=review
CRE_TARGET=staging-settings
CRE_BROADCAST=true
CRE_TIMEOUT_MS=300000
CRE_QUICKNODE_SOLANA_DEVNET_RPC_URL=REPLACE
CRE_HELIUS_SOLANA_DEVNET_RPC_URL=REPLACE
CRE_ALCHEMY_SOLANA_DEVNET_RPC_URL=REPLACE
CRE_SCORECHAIN_SANCTIONS_API_KEY=REPLACE_IF_SCREENING_ENABLED
CRE_SOLANA_PRIVATE_KEY=REPLACE_WITH_DEVNET_TRANSMITTER_BASE58_KEYPAIR
CRE_ETH_PRIVATE_KEY=REPLACE_WITH_THROWAWAY_HEX_KEY
CRE_POLICY_DOCUMENT=REPLACE_WITH_ONE_LINE_PRIVATE_POLICY_JSON
# Optional content-addressed policy retrieval and member policy management.
POLICY_FETCH_TOKEN=REPLACE_WITH_RANDOM_TOKEN
CRE_POLICY_STORE_TOKEN=REPLACE_WITH_SAME_POLICY_FETCH_TOKEN
# Optional authenticated manual retry / operator mode switch.
REVIEW_TOKEN=REPLACE_WITH_RANDOM_TOKEN
ADMIN_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Live DON alternative; requires a real deployed workflow and the matching live-forwarder treasury.
# CRE_PROJECT_DIR=
# CRE_WORKFLOW_ID=
# CRE_GATEWAY_PRIVATE_KEY=
# CRE_GATEWAY_URL=https://01.gateway.zone-a.cre.chain.link
